{
	"name": "PL_SILVER_TO_GOLD",
	"properties": {
		"activities": [
			{
				"name": "readTableSilverToGoldFromControlTable",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select table_id,gold_table_name\n from ctrl.table_config  where is_active=1 and source_system='@{pipeline().parameters.source_system}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "IngestAllTable",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "readTableSilverToGoldFromControlTable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('readTableSilverToGoldFromControlTable').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "updateStatusInProgress",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "INSERT INTO ctrl.audit_log\n(\n    adf_run_id,\n    table_id,\n    status,\n    start_time,\n    stage\n)\nVALUES\n(\n    '@{pipeline().RunId}',\n    @{pipeline().parameters.run_id},\n    'IN_PROGRESS',\n    '@{convertFromUtc(utcNow(),'India Standard Time')}',\n    'SILVER_TO_GOLD'\n);",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "updateStatusFailure",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "SilverToGold",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.audit_log\nSET\n    status = 'FAILED',\n    end_time = '@{convertFromUtc(utcNow(),'India Standard Time')}'\nWHERE\n    table_id = @{item().table_id}\n    AND adf_run_id = '@{pipeline().parameters.run_id}';",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "SilverToGold",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "updateStatusInProgress",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": {
									"value": "@concat(\n    '/ADB-HOSPITAL-REPO/ADB_REPO/Gold/NB_',\n    item().gold_table_name\n)",
									"type": "Expression"
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AzureDatabricks",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "updateStatusCompleted",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "SilverToGold",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.audit_log\nSET\n    status = 'SUCCESS',\n    records_written = TRY_CONVERT(\n        INT,\n        '@{activity('SilverToGold').output.runOutput}'\n    ),\n    end_time = SYSUTCDATETIME()\nWHERE\n    table_id = @{item().table_id}\n    AND adf_run_id = '@{pipeline().parameters.run_id}';",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"run_id": {
				"type": "string"
			},
			"source_system": {
				"type": "string",
				"defaultValue": "silver"
			}
		},
		"variables": {
			"tableId": {
				"type": "String"
			}
		},
		"annotations": []
	}
}